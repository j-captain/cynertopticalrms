NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/cynert_optical
JWT_SECRET=change_this_to_a_long_random_secure_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Admin bootstrap
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@cynert.com
ADMIN_PASSWORD=Admin@12345

# SMTP (configure with your provider e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Cynert Optical <your_email@gmail.com>"
ORDER_RECIPIENT_EMAIL=orders@cynert.com